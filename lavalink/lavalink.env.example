# Development: copy this file to lavalink.env and export these variables before Java starts.
# Production: install a privately configured copy at /etc/discord-music-bot/lavalink.env.
# Generate a unique password and use the same value in the Bot environment.
LAVALINK_PASSWORD=

# YouTube OAuth credentials are private. Never commit the real refresh token.
# Leave empty for the plugin's device-code authorization flow.
YOUTUBE_OAUTH_REFRESH_TOKEN=

# Optional local helpers. Override these when using a different deployment layout.
LAVALINK_URL=http://127.0.0.1:2333
YOUTUBE_POT_PROVIDER_URL=http://127.0.0.1:4416

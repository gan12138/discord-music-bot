[Unit]
Description=Refresh Lavalink YouTube poToken
After=network-online.target docker.service lavalink.service
Wants=network-online.target docker.service
Requires=lavalink.service

[Service]
Type=oneshot
User=lavalink
Group=lavalink
Environment="REFRESH_SCRIPT=/opt/discord-music-bot/lavalink/refresh-youtube-pot.sh"
Environment="LAVALINK_ENV_FILE=/etc/discord-music-bot/lavalink.env"
ExecStart=/usr/bin/env bash ${REFRESH_SCRIPT}
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

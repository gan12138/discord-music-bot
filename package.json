{
  "name": "discord-music-bot",
  "version": "1.0.0",
  "description": "A Discord music bot with YouTube and Spotify support",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node src/deploy-commands.js",
    "check": "for f in src/**/*.js src/*.js; do node --check \"$f\" || exit 1; done"
  },
  "keywords": [
    "discord",
    "music",
    "bot",
    "youtube",
    "spotify"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.1",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "lavalink-client": "^2.10.3",
    "libsodium-wrappers": "^0.7.13",
    "opusscript": "^0.0.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

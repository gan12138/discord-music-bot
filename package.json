{
  "name": "discord-music-bot",
  "version": "2.0.0",
  "description": "Discord music bot with YouTube, Bilibili, Spotify, radio and optional voice control",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node src/deploy-commands.js",
    "check": "for f in src/**/*.js src/*.js; do node --check \"$f\" || exit 1; done",
    "test": "node --test --test-concurrency=1 --import ./test/setup.js test/*.test.js",
    "check:voice-stt": "node src/check-voice-stt.js"
  },
  "keywords": [
    "discord",
    "music",
    "bot",
    "youtube",
    "spotify"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.33",
    "@discordjs/voice": "^0.19.2",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "ai": "^7.0.44",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.1",
    "ffmpeg-static": "^5.2.0",
    "lavalink-client": "^2.10.3",
    "libsodium-wrappers": "^0.7.13",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
# Optional test guild for immediate command updates. Leave empty for production.
DISCORD_GUILD_ID=
# Global deployment requires explicit opt-in: ALLOW_GLOBAL_COMMAND_DEPLOY=true
ALLOW_GLOBAL_COMMAND_DEPLOY=false

# Optional: AI relay for radio recommendations and /ai-music (OpenAI-compatible/NewAPI).
# When AI_ENABLED=true, explicitly configure a public HTTPS AI_BASE_URL and API key.
# There is no built-in relay address.
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=15000

# Optional: let Radio use AI to generate recommendation search queries.
# Disabled by default for stable autoplay; /ai-music still uses AI_ENABLED.
RADIO_AI_ENABLED=false

# Optional: yt-dlp cookies for Bilibili (legacy fallback name, Netscape cookies.txt format)
# Comma-separated cookie file paths; the first non-empty path is used.
YTDLP_COOKIE_FILES=
# Optional: Bilibili-specific cookies (overrides YTDLP_COOKIE_FILES for Bilibili only)
YTDLP_BILIBILI_COOKIE_FILES=
# Optional: YouTube-specific cookies (never falls back to the Bilibili files,
# so platform login cookies are never sent to other sites)
YTDLP_YOUTUBE_COOKIE_FILES=

# Optional: maximum concurrent yt-dlp metadata/search processes
YTDLP_MAX_CONCURRENT=6

# Optional: force a specific ffmpeg binary for local playback / Lavalink fallback.
# Default resolution order: FFMPEG_BIN -> /usr/bin/ffmpeg -> /usr/local/bin/ffmpeg
# -> PATH ffmpeg -> bundled ffmpeg-static. The binary must be built with --enable-libopus.
# NOTE: dotenv/config is imported before ffmpeg resolution in src/index.js, so this
# variable is honoured; keep that import order when editing src/index.js.
FFMPEG_BIN=

# Optional: local backend audio buffering
AUDIO_BUFFER_MB=8
AUDIO_PREBUFFER_MS=1500
# Optional: treat local playback as stalled after this many ms without audio data
# (platform throttling/disconnect); the song is then retried or skipped with a channel notice
LOCAL_STREAM_STALL_MS=20000
# One startup/recovery episode, shared by backend retries and Radio alternatives.
# A confirmed audio start clears its watchdog; sustained playback resets retry counts.
PLAYBACK_RECOVERY_TIMEOUT_MS=45000
# One Lavalink retry for a confirmed transient source/network failure (plus <200ms jitter).
LAVALINK_TRACK_RETRY_DELAY_MS=1000
# Maximum time for a Lavalink retry to confirm audio output (includes REST/loading).
LAVALINK_TRACK_RETRY_TIMEOUT_MS=8000
# Preserve this part of the shared budget for local voice reconnect/extraction/start.
# Skip the Lavalink retry when less than 3s remains after its delay and this reserve.
LOCAL_FALLBACK_RESERVE_MS=15000

# Optional: extra playback logs
PLAYER_DEBUG=false
RADIO_DEBUG=false
PLAY_TIMING=false
VOICE_DEBUG=false

# Optional: second Discord bot used only to receive voice commands.
# Leave empty to disable voice control without affecting the music bot.
VOICE_LISTENER_ENABLED=false
VOICE_LISTENER_TOKEN=

# Speech-to-text provider: vercel-ai-gateway for xai/grok-stt, or openai-compatible.
VOICE_STT_PROVIDER=vercel-ai-gateway
VOICE_STT_GATEWAY_API_KEY=
VOICE_STT_GATEWAY_BASE_URL=
VOICE_STT_MODEL=xai/grok-stt
VOICE_STT_SAMPLE_RATE=24000

# Used only when VOICE_STT_PROVIDER=openai-compatible.
# If a custom VOICE_STT_GATEWAY_BASE_URL is set and the gateway reuses the
# same credential, Gateway mode may fall back to VOICE_STT_API_KEY.
VOICE_STT_BASE_URL=https://api.openai.com/v1
VOICE_STT_API_KEY=
VOICE_STT_TIMEOUT_MS=15000
VOICE_CONTROL_MAX_GUILD_JOBS=4
VOICE_CONTROL_MAX_GLOBAL_JOBS=4
VOICE_CONTROL_DUCK_VOLUME=15
VOICE_CONTROL_AI_CONFIDENCE=0.88
VOICE_CONTROL_AI_TIMEOUT_MS=8000
VOICE_CONTROL_MAX_AI_JOBS=2
VOICE_CONTROL_MAX_AI_PER_USER_MINUTE=4
VOICE_CONTROL_MAX_AI_PER_GUILD_MINUTE=12
VOICE_CONTROL_MAX_USER_SEGMENTS_PER_MINUTE=12
VOICE_CONTROL_MAX_GUILD_SEGMENTS_PER_MINUTE=60
VOICE_CONTROL_SEARCH_DEADLINE_MS=15000
VOICE_CONTROL_COMMAND_DEADLINE_MS=30000
VOICE_CONTROL_FOCUS_DEADLINE_MS=45000
VOICE_CONTROL_DEBUG=0

# Per-guild STT access is managed with /voice-control stt-policy.
# Guilds default to everyone mode, with member opt-out via /voice-consent revoke.
# Voice segments go to the configured STT provider before wake-word recognition.

# Playback backend. Use "local" for yt-dlp+ffmpeg in the bot process, or "lavalink".
PLAYER_BACKEND=lavalink

# Lavalink backend settings. Required when PLAYER_BACKEND=lavalink.
# Generate a unique password and provide the same value to Lavalink and the Bot.
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false
LAVALINK_NAME=main
# Node reconnects cover slow JVM restarts; exhausted nodes are recreated automatically.
LAVALINK_RETRY_AMOUNT=12
LAVALINK_RETRY_DELAY_MS=10000
